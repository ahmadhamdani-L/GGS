    # Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# PostgreSQL
POSTGRES_DB=ggs_werewolf
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password

# Go server
DATABASE_URL=postgres://postgres:change_me_strong_password@db:5432/ggs_werewolf?sslmode=disable
JWT_SECRET=change_me_at_least_32_chars_long_random_string
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# App environment: development | staging | production
APP_ENV=production

# Debug endpoint key — leave empty in production to disable the endpoint
DEBUG_KEY=

# Avatar upload directory (absolute path recommended in production)
AVATAR_UPLOAD_DIR=./uploads/avatars

# Firebase / FCM push notifications
FCM_SERVER_KEY=your_fcm_server_key_here

# Midtrans Payment Gateway (Diamond top-up)
# Get from https://dashboard.midtrans.com → Settings → Access Keys
MIDTRANS_SERVER_KEY=your_midtrans_server_key
MIDTRANS_CLIENT_KEY=your_midtrans_client_key
MIDTRANS_ENV=sandbox
# Set to "production" when ready for real payments

# Admin API key (for protected admin endpoints like /api/diamonds/topup, /api/gifts/analytics)
ADMIN_KEY=your_admin_secret_key_here

# Logging
LOG_LEVEL=info
